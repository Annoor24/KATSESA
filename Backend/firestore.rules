rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Academic Resources: Everyone can read, only Admins can write
    match /academic_resources/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Association News: Everyone can read, only Admins can write
    match /association_news/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Events Archive: Everyone can read, only Admins can write
    match /events_archive/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
