rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Materials & Events: Public read, Auth-only write
    match /materials/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
